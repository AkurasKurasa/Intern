{
  "name": "intern-recorder",
  "version": "1.0.0",
  "description": "Intern — BC Demo Recorder (Electron UI over the Python DemoRecorder backend)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "Intern",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.intern.recorder",
    "productName": "Intern",
    "win": {
      "target": "nsis"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      { "from": "../app", "to": "app", "filter": ["**/*", "!**/__pycache__/**"] },
      { "from": "../components", "to": "components", "filter": ["**/*", "!**/__pycache__/**"] },
      { "from": "../tasks", "to": "tasks", "filter": ["**/*", "!**/__pycache__/**", "!**/traces/**", "!**/traces_aug/**", "!**/submissions/**"] },
      { "from": "../practice_apps", "to": "practice_apps", "filter": ["**/*", "!**/__pycache__/**"] },
      { "from": "../data_entry_tasks", "to": "data_entry_tasks", "filter": ["**/*"] },
      { "from": "../run_task.py", "to": "run_task.py" }
    ]
  }
}
